{
  "name": "echo-security-scanner",
  "version": "1.0.0",
  "description": "Container image CVE scanner with Trivy, BullMQ, Prisma, and Express",
  "type": "module",
  "main": "dist/api.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node -e \"const {cpSync}=require('fs');cpSync('src/common/utils/log/log-transport.mjs','dist/common/utils/log/log-transport.mjs')\"",
    "dev": "tsx watch src/api/index.ts",
    "dev:worker": "tsx watch src/bullmq/index.ts",
    "start": "node dist/api/index.js",
    "start:worker": "node dist/bullmq/index.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --forceExit --runInBand",
    "lint": "eslint src tests --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prepare": "node -e \"if(process.env.HUSKY==='0'||process.env.CI)process.exit(0)\" && husky || true"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "prisma": "^6.0.0",
    "bullmq": "^5.0.0",
    "dotenv": "^16.0.0",
    "execa": "^9.0.0",
    "express": "^4.21.0",
    "ioredis": "^5.0.0",
    "pino": "^9.0.0",
    "pino-abstract-transport": "^2.0.0",
    "pino-roll": "^1.0.0",
    "stream-json": "^1.8.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@jest/globals": "^29.7.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^22.0.0",
    "@types/stream-json": "^1.7.0",
    "@types/supertest": "^7.2.0",
    "cross-env": "^7.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "jest": "^29.0.0",
    "lint-staged": "^15.0.0",
    "supertest": "^7.2.2",
    "testcontainers": "^10.0.0",
    "ts-jest": "^29.0.0",
    "tsc-alias": "^1.8.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "cpu-features",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "protobufjs",
      "ssh2"
    ]
  }
}
