# ── Database ──────────────────────────────────────────────────────────────────
# Credentials used by both the postgres container and the app's connection string.
# If you change POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB, update
# DATABASE_URL to match.
POSTGRES_USER=scanner
POSTGRES_PASSWORD=scanner
POSTGRES_DB=scanner

# Docker Compose: container hostname (postgres).
# Local dev (pnpm dev): change @postgres to @localhost.
DATABASE_URL=postgresql://scanner:scanner@postgres:5432/scanner

# ── Redis (BullMQ backend) ────────────────────────────────────────────────────
# Docker Compose: container hostname (redis).
# Local dev: change to redis://localhost:6379.
REDIS_URL=redis://redis:6379

# ── Trivy server ──────────────────────────────────────────────────────────────
# Docker Compose: container hostname (trivy-server).
# Local dev: change to http://localhost:8080.
TRIVY_SERVER_URL=http://trivy-server:8080

# ── Scan schedule ─────────────────────────────────────────────────────────────
# How often the BullMQ scheduler triggers a full image scan (milliseconds).
SCAN_INTERVAL_MS=900000 

# ── Health check ──────────────────────────────────────────────────────────────
# How old the most recent scan can be before /health reports scanner as stale.
# Should be at least 2x SCAN_INTERVAL_MS to tolerate one missed tick.
SCANNER_STALENESS_THRESHOLD_MS=1800000

# ── Storage hygiene ───────────────────────────────────────────────────────────
# ImageVulnerability rows not seen by any scan in this many days are hard-deleted
# by the weekly hygiene job. Does not affect API staleness filtering.
VULNERABILITY_RETENTION_DAYS=30

# ── Host port mappings (used by docker-compose.yml for port forwarding) ────────
# Change these to avoid conflicts with other services on your host.
API_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
TRIVY_PORT=8080

# ── API ───────────────────────────────────────────────────────────────────────
# Port the Express server listens on inside the container.
PORT=3000

# ── Logging ───────────────────────────────────────────────────────────────────
# info | debug | warn | error
LOG_LEVEL=info

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
