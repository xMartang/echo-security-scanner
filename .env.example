# Database
DATABASE_URL=postgresql://scanner:scanner@localhost:5432/scanner

# Redis (BullMQ backend)
REDIS_URL=redis://localhost:6379

# Trivy server
TRIVY_SERVER_URL=http://localhost:8080

# Scan interval in milliseconds (default: 15 minutes)
SCAN_INTERVAL_MS=900000

# API port
PORT=3000

# Logging
LOG_LEVEL=info
LOG_DIR=./logs/local
SERVICE_NAME=api
